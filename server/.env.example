# Copy to .env for local development. On Railway, set these as project
# environment variables instead (DATABASE_URL is auto-injected by the
# Postgres plugin, don't set it manually there).

# Shared secret the ESP32 sends as the X-Api-Key header.
DESKBOT_API_KEY=change-me-device-key

# Website login gate. Leave unset/blank to disable the login page entirely
# (fine for local dev, NOT recommended once deployed publicly on Railway).
WEB_PASSWORD=change-me-web-password

# Long random string used to sign the web session cookie.
SESSION_SECRET=change-me-to-a-long-random-value

# Marks the session cookie Secure (HTTPS-only). Leave True/unset in
# production (Railway serves HTTPS). Set to False only for local plain-http
# dev if you're testing the login flow (WEB_PASSWORD set) without HTTPS.
SESSION_COOKIE_SECURE=True

# Local dev defaults to SQLite; Railway provides DATABASE_URL via its
# Postgres plugin (postgres://... — the app normalizes it automatically).
DATABASE_URL=sqlite:///./deskbot.db

MEDIA_DIR=./media
DEFAULT_FPS=10
MAX_JOB_DURATION_S=1200

# "Low" quality tier, encoded alongside the default ("high") tier for every
# queued video so the device can fall back to it on a weak connection.
# Optional — safe defaults apply if unset.
# LOW_FPS=8
# LOW_JPEG_Q=22
